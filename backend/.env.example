# CognoDB / Neo4j connection — from console.cognodb.com
# Copy .env.example to .env and fill in your instance details.
NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=<generated-password>

# Backend port and allowed frontend origin (CORS)
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# JWT secret for auth (use a long random string, e.g. openssl rand -hex 48)
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=7d
